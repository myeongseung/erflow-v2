<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  출처: legacy/ERFlow/src/main/java/service/implementation/UnitServiceImpl.java
  레거시 SQL 을 그대로 옮긴다. 성능이나 취향을 이유로 바꾸지 않는다 —
  결과가 달라지면 정합성을 판정할 수 없다.
-->
<mapper namespace="com.erflow.unit.UnitMapper">

    <!--
      검색 컬럼을 문자열로 이어 붙이지 않고 분기로 고정한다. 레거시는 화이트리스트에
      있는 값만 이어 붙여 주입을 막았는데, 여기서는 SQL 자체가 정적이라 주입할 자리가
      아예 없다. 같은 안전성을 얻으면서 검사 하나를 덜 믿어도 된다.
    -->
    <sql id="searchCondition">
        <if test="search != null and search.active">
            WHERE
            <choose>
                <when test="search.column == 'id'">id</when>
                <when test="search.column == 'unit_name'">unit_name</when>
                <when test="search.column == 'user_name'">user_name</when>
                <when test="search.column == 'document_name'">document_name</when>
                <when test="search.column == 'status'">status</when>
                <when test="search.column == 'created_at'">created_at</when>
            </choose>
            LIKE #{search.pattern}
        </if>
    </sql>

    <!-- 레거시: select * from unit_view [where <col> like ?] order by id limit ?, ? -->
    <select id="findPage" resultType="com.erflow.unit.UnitRow">
        SELECT id, unit_name, user_name, document_name, status, created_at
          FROM unit_view
        <include refid="searchCondition"/>
         ORDER BY id
         LIMIT #{start}, #{count}
    </select>

    <!-- 레거시: select count(*) from unit_view [where <col> like ?] -->
    <select id="countBy" resultType="int">
        SELECT COUNT(*)
          FROM unit_view
        <include refid="searchCondition"/>
    </select>

    <!-- 레거시: select * from unit_tbl where id = ? -->
    <select id="findById" resultType="com.erflow.unit.Unit">
        SELECT id,
               user_tbl_charger_id AS chargerId,
               document_tbl_id     AS documentId,
               name,
               status,
               created_at          AS createdAt
          FROM unit_tbl
         WHERE id = #{id}
    </select>

    <!--
      레거시: insert into unit_tbl values(?, ?, ?, ?, 1, ?)
      컬럼을 적지 않은 위치 기반 INSERT 였다. status 는 1(가동중) 고정이다.
      컬럼명을 명시해도 넣는 값은 같다 — 테이블 컬럼 순서가 바뀌어도 깨지지 않는다.
    -->
    <insert id="insert">
        INSERT INTO unit_tbl
                    (id, user_tbl_charger_id, document_tbl_id, name, status, created_at)
             VALUES (#{unit.id}, #{unit.chargerId}, #{unit.documentId},
                     #{unit.name}, 1, #{unit.createdAt})
    </insert>

    <!--
      레거시: update unit_tbl set user_tbl_charger_id = ?, document_tbl_id = ?,
              name = ?, status = ? where id = ?
      제조일자는 수정 대상이 아니다. 화면에도 없다.
    -->
    <update id="update">
        UPDATE unit_tbl
           SET user_tbl_charger_id = #{unit.chargerId},
               document_tbl_id     = #{unit.documentId},
               name                = #{unit.name},
               status              = #{unit.status}
         WHERE id = #{unit.id}
    </update>

    <!-- 레거시: delete from unit_tbl where id = ? -->
    <delete id="delete">
        DELETE FROM unit_tbl
         WHERE id = #{id}
    </delete>

</mapper>
