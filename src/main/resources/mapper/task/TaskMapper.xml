<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  출처: legacy/ERFlow/src/main/java/service/implementation/TaskServiceImpl.java
  레거시 SQL 을 그대로 옮긴다. 정렬은 task_id 오름차순이다.

  검색 컬럼을 문자열로 이어 붙이지 않고 분기로 고정한다. 레거시는 화이트리스트에
  있는 keyfield 만 컬럼으로 바꿔 붙였는데, 여기서는 SQL 이 분기별로 정적이라 주입할
  자리가 없다.
-->
<mapper namespace="com.erflow.task.TaskMapper">

    <!--
      레거시 조건 분기(getTasks / getTaskCount)
        userName/deptName/companyName  and <col> like ?
        date                           and task_at >= ?
        status                         and status = ?
      «전체조회»(빈 keyfield)는 조건 없음.
    -->
    <sql id="searchCondition">
        <if test="search != null and search.active">
            <choose>
                <when test="search.like">
                    AND
                    <choose>
                        <when test="search.column == 'user_name'">user_name</when>
                        <when test="search.column == 'dept_name'">dept_name</when>
                        <when test="search.column == 'company_name'">company_name</when>
                    </choose>
                    LIKE #{search.pattern}
                </when>
                <when test="search.date">
                    AND task_at &gt;= #{search.dateValue}
                </when>
                <when test="search.status">
                    AND status = #{search.statusValue}
                </when>
            </choose>
        </if>
    </sql>

    <!-- 레거시: select * from task_view where type = ? [조건] order by task_id limit ?, ? -->
    <select id="findPage" resultType="com.erflow.task.TaskRow">
        SELECT task_id   AS id,
               user_name AS userName,
               dept_name AS deptName,
               company_name AS companyName,
               subject,
               task_at   AS taskAt,
               status
          FROM task_view
         WHERE type = #{type}
        <include refid="searchCondition"/>
         ORDER BY task_id
         LIMIT #{start}, #{count}
    </select>

    <!-- 레거시: select count(*) from task_view where type = ? [조건] -->
    <select id="countBy" resultType="int">
        SELECT COUNT(*)
          FROM task_view
         WHERE type = #{type}
        <include refid="searchCondition"/>
    </select>

    <!--
      레거시: insert into task_tbl values (null, ?, ?, ?, ?, ?, now(), ?)
      위치 기반이었다. 컬럼명을 명시해도 넣는 값은 같다 — 테이블 컬럼 순서가 바뀌어도
      깨지지 않는다. created_at 은 now(), id 는 AUTO_INCREMENT.
    -->
    <insert id="insertTask">
        INSERT INTO task_tbl
                    (user_tbl_id, company_tbl_id, document_tbl_id, type, task_at, created_at, status)
             VALUES (#{task.userId}, #{task.companyId}, #{task.documentId},
                     #{task.type}, #{task.taskAt}, NOW(), #{task.status})
    </insert>

    <!-- 레거시는 Statement.RETURN_GENERATED_KEYS 로 읽었다. 같은 커넥션에서 부른다. -->
    <select id="lastInsertId" resultType="int">
        SELECT LAST_INSERT_ID()
    </select>

    <!-- 레거시: insert into task_history_tbl values (?, ?, ?) -->
    <insert id="insertHistory">
        INSERT INTO task_history_tbl
                    (task_tbl_id, product_tbl_id, count)
             VALUES (#{history.taskId}, #{history.productId}, #{history.count})
    </insert>

    <!--
      레거시 모달: getTaskHistories("task_tbl_id", taskId) 로 이력을 읽고, 이력마다
      getProduct(productId) 로 이름을 다시 조회했다(N+1). 결과가 같은 조인으로 합친다.
        레거시 이력:  select * from task_history_tbl where task_tbl_id = ? order by task_tbl_id
        레거시 제품:  select * from product_tbl where id = ?
    -->
    <select id="findHistories" resultType="com.erflow.task.TaskHistoryRow">
        SELECT h.product_tbl_id AS productId,
               p.name           AS name,
               h.count          AS count
          FROM task_history_tbl h
          JOIN product_tbl p ON h.product_tbl_id = p.id
         WHERE h.task_tbl_id = #{taskId}
         ORDER BY h.task_tbl_id
    </select>

    <!--
      레거시: select * from task_tbl where id = ? (getTask)
      document_tbl_id·company_tbl_id 는 NULL 일 수 있다. 레거시 extractViewtTaskBean 이
      rs.getInt 로 읽어 NULL 을 0 으로 봤다 — COALESCE 로 같게 맞춘다(record 의 int 가
      NULL 을 못 받는다).
    -->
    <select id="findById" resultType="com.erflow.task.TaskDetail">
        SELECT id,
               user_tbl_id                AS userId,
               COALESCE(company_tbl_id, 0)  AS companyId,
               COALESCE(document_tbl_id, 0) AS documentId,
               type,
               task_at                    AS taskAt,
               status
          FROM task_tbl
         WHERE id = #{id}
    </select>

    <!--
      레거시: update task_tbl set user_tbl_id=?, document_tbl_id=?, task_at=?, status=?
              where id=? and type=?
      type 은 언제나 0 이다(D-044). 회사·생성시각은 건드리지 않는다.
    -->
    <update id="updateTask">
        UPDATE task_tbl
           SET user_tbl_id     = #{task.userId},
               document_tbl_id = #{task.documentId},
               task_at         = #{task.taskAt},
               status          = #{task.status}
         WHERE id = #{task.id}
           AND type = #{task.type}
    </update>

    <!-- 레거시: delete from task_history_tbl where task_tbl_id = ? -->
    <delete id="deleteHistories">
        DELETE FROM task_history_tbl
         WHERE task_tbl_id = #{taskId}
    </delete>

    <!-- 레거시: delete from task_tbl where id = ? and type = ? (이력은 먼저 지운다) -->
    <delete id="deleteTask">
        DELETE FROM task_tbl
         WHERE id = #{id}
           AND type = #{type}
    </delete>

</mapper>
