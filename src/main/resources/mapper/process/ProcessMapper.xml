<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  출처: legacy/ERFlow/src/main/java/service/implementation/ProcessServiceImpl.java
-->
<mapper namespace="com.erflow.process.ProcessMapper">

    <!--
      레거시 getProcesses(keyfield, keyword, start, cnt):
        select * from process_tbl [where <칸> like ? | where priority = ?] order by id limit ?, ?

      우선순위만 정확히 같은 값을 찾는다. 나머지 둘은 부분 일치다.
    -->
    <sql id="searchCondition">
        <if test="search.byText">
            WHERE ${search.column} LIKE #{search.keywordPattern}
        </if>
        <if test="search.byPriority">
            WHERE priority = #{search.priority}
        </if>
    </sql>

    <select id="findPage" resultType="com.erflow.process.ProcessRow">
        SELECT id,
               process_tbl_prev_id AS prevId,
               process_tbl_next_id AS nextId,
               name,
               priority
          FROM process_tbl
        <include refid="searchCondition"/>
         ORDER BY id
         LIMIT #{start}, #{count}
    </select>

    <!-- 레거시 processesCount: select count(*) from process_tbl [조건] -->
    <select id="countBy" resultType="int">
        SELECT COUNT(*)
          FROM process_tbl
        <include refid="searchCondition"/>
    </select>

    <!-- 레거시 getProcess(id): select * from process_tbl where id = ? -->
    <select id="findById" resultType="com.erflow.process.ProcessRow">
        SELECT id,
               process_tbl_prev_id AS prevId,
               process_tbl_next_id AS nextId,
               name,
               priority
          FROM process_tbl
         WHERE id = #{id}
    </select>

    <!--
      레거시: insert into process_tbl values(?, ?, ?, ?, ?)
      바인딩 순서는 id, prevId, nextId, name, priority 다.
    -->
    <insert id="insertProcess">
        INSERT INTO process_tbl
                    (id, process_tbl_prev_id, process_tbl_next_id, name, priority)
             VALUES (#{id}, #{prevId}, #{nextId}, #{name}, #{priority})
    </insert>

    <!-- 레거시 updateProcess: update process_tbl set name = ? where id = ? -->
    <update id="updateName">
        UPDATE process_tbl SET name = #{name} WHERE id = #{id}
    </update>

    <!--
      삭제는 이제 우리 SQL 이다(D-133). 레거시는 저장 프로시저 DeleteProcess 를
      불렀는데(D-073) 그 정의를 볼 수 없었고(erflow 에 존재하지만 앱 계정에 조회
      권한이 없다), erflow_v2 에는 프로시저가 없어 삭제가 영영 실패하는 상태였다.
      고리 잇기와 자리 번호 당기기는 ProcessService 가 순서대로 지시한다 —
      비트마스크와 같은 이유로 판정을 SQL 에 몰지 않는다.
    -->
    <update id="updateNextOf">
        UPDATE process_tbl SET process_tbl_next_id = #{nextId} WHERE id = #{id}
    </update>

    <update id="updatePrevOf">
        UPDATE process_tbl SET process_tbl_prev_id = #{prevId} WHERE id = #{id}
    </update>

    <update id="decrementPriority">
        UPDATE process_tbl SET priority = priority - 1 WHERE id = #{id}
    </update>

    <!-- 공정을 가리키는 기록 — 관리(management_tbl)·생산(production_tbl) -->
    <select id="countReferences" resultType="int">
        SELECT (SELECT COUNT(*) FROM management_tbl WHERE process_tbl_id = #{id})
             + (SELECT COUNT(*) FROM production_tbl WHERE process_tbl_id = #{id})
    </select>

    <delete id="deleteById">
        DELETE FROM process_tbl WHERE id = #{id}
    </delete>

</mapper>
