<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  출처: legacy/ERFlow/src/main/java/service/implementation/DocumentServiceImpl.java
-->
<mapper namespace="com.erflow.document.DocumentMapper">

    <!--
      레거시 getDocumentViews(null, null, "user", userId) 가 만드는 SQL 이다.
        select * from document_view where user_id = ? order by id desc
    -->
    <select id="findByUser" resultType="com.erflow.document.DocumentRow">
        SELECT id, subject
          FROM document_view
         WHERE user_id = #{userId}
         ORDER BY id DESC
    </select>

    <!--
      결재에 올린 적 없는 내 문서(D-161). 전에는 findByUser 뒤에 문서마다 countProposals
      를 불렀다. 결재 올리기가 결재 리스트 위의 대화상자가 되면서 리스트를 열 때마다
      이 목록을 읽게 됐으므로 한 질의로 줄였다(D-152) — «건수가 0» 과 «행이 없다» 는
      같은 말이다.
    -->
    <select id="findProposable" resultType="com.erflow.document.DocumentRow">
        SELECT d.id, d.subject
          FROM document_view d
         WHERE d.user_id = #{userId}
           AND NOT EXISTS (SELECT 1 FROM proposal_tbl p WHERE p.document_tbl_id = d.id)
         ORDER BY d.id DESC
    </select>

    <!--
      레거시 hasProposal: select count(*) from proposal_tbl where document_tbl_id = ?
      문서 수정·삭제가 «결재 진행 중인가» 를 볼 때 쓴다. 찾기 쪽은 findProposable 로
      합쳤다(D-161).
    -->
    <select id="countProposals" resultType="int">
        SELECT COUNT(*)
          FROM proposal_tbl
         WHERE document_tbl_id = #{documentId}
    </select>

    <!--
      레거시 getDocumentViews(keyfield, keyword, "user", userId, start, cnt):
        select * from document_view [where <조건>] [and|where user_id = ?]
        order by id desc limit ?, ?

      내 문서만 본다 — 목록 화면이 flag="user" 로 부르기 때문이다.
      문서ID 검색만 정확히 같은 값이고 나머지 둘은 부분 일치다.
    -->
    <sql id="searchCondition">
        <where>
            <if test="search.bySubject">
                subject LIKE #{search.keywordPattern} AND
            </if>
            <if test="search.byTemplate">
                template_name LIKE #{search.keywordPattern} AND
            </if>
            <if test="search.byId">
                id = #{search.id} AND
            </if>
            user_id = #{userId}
        </where>
    </sql>

    <!--
      결재 상태는 document_tbl.proposal_status 가 아니라 proposal_tbl 에서 읽는다(D-160).
      그 칸은 넣을 때 0 을 적은 뒤 아무도 고치지 않는다. 결재는 한 차례마다 행이 하나
      늘고(승인하면 다음 차례 행을 넣는다), 끝나면 그 문서의 행 전부를 1(승인)·2(반려)로
      바꾼다. 그래서 마지막 행의 result 가 곧 문서의 결재 상태다 — 3 이면 진행 중.
      행이 없으면 NULL — 결재에 올린 적이 없다.
    -->
    <select id="findPage" resultType="com.erflow.document.DocumentListRow">
        SELECT id,
               subject,
               template_name AS templateName,
               created_at    AS createdAt,
               updated_at    AS updatedAt,
               (SELECT p.result
                  FROM proposal_tbl p
                 WHERE p.document_tbl_id = document_view.id
                 ORDER BY p.id DESC
                 LIMIT 1)    AS proposalStatus
          FROM document_view
        <include refid="searchCondition"/>
         ORDER BY id DESC
         LIMIT #{start}, #{count}
    </select>

    <!-- 레거시 getDocumentCount: select count(*) from document_view [조건] -->
    <select id="countBy" resultType="int">
        SELECT COUNT(*)
          FROM document_view
        <include refid="searchCondition"/>
    </select>

    <!-- 레거시 getDocumentView(id): select * from document_view where id = ? -->
    <select id="findDetail" resultType="com.erflow.document.DocumentDetail">
        SELECT id,
               user_id AS userId,
               subject,
               content
          FROM document_view
         WHERE id = #{id}
    </select>

    <!--
      레거시: insert into document_tbl values (null, ?, ?, ?, ?, ?, 0, 0, now(), null)
      바인딩 순서는 userId, routeId, templateId, subject, content 다. 결재라인은
      문서를 만들 때 정하지 않으므로 언제나 0 이 들어간다.
    -->
    <insert id="insertDocument">
        INSERT INTO document_tbl
                    (user_tbl_id, proposal_route_tbl_id, template_tbl_id,
                     subject, content, doc_status, proposal_status, created_at, updated_at)
             VALUES (#{userId}, 0, #{templateId}, #{subject}, #{content}, 0, 0, NOW(), NULL)
    </insert>

    <!--
      레거시: update document_tbl set proposal_route_tbl_id = ?, template_tbl_id = ?,
             subject = ?, content = ?, updated_at = now() where id = ?
      결재라인 자리에도 0 이 들어간다 — 화면이 그 값을 보내지 않는다.
    -->
    <update id="updateDocument">
        UPDATE document_tbl
           SET proposal_route_tbl_id = 0,
               template_tbl_id = #{templateId},
               subject = #{subject},
               content = #{content},
               updated_at = NOW()
         WHERE id = #{id}
    </update>

    <!-- 레거시: delete from document_tbl where id = ? -->
    <delete id="deleteDocument">
        DELETE FROM document_tbl WHERE id = #{id}
    </delete>

</mapper>
