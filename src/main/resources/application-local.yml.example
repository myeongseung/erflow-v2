# 로컬 접속 설정 템플릿.
#
# 이 파일을 같은 디렉터리에 `application-local.yml` 로 복사한 뒤 값을 채운다.
# 복사본은 .gitignore(`**/application-local.yml`) 에 걸려 커밋되지 않는다.
#
#   cp application-local.yml.example application-local.yml
#
# 사용: ./gradlew bootRun --args='--spring.profiles.active=local'
#
# 값을 여기(.example)에 채워 넣지 않는다. 이 파일은 커밋된다.

# 스키마가 셋이다 (D-116).
#
#   erflow      레거시 정답. SELECT 만. 읽기 전용을 권한으로 막는다
#   erflow_mig  전작(parity-harness)의 1단계 산출물. 동결 — 손대지 않는다
#   erflow_v2   이 저장소의 앱 스키마. 읽고 쓴다
#
# 앱 코드는 스키마 이름을 모른다 — 매퍼의 테이블명이 전부 비수식이라
# 어느 스키마를 쓰는지는 아래 URL 하나가 정한다.

spring:
  datasource:
    # 이 저장소의 앱 스키마. 앱이 읽고 쓴다.
    #
    # 만들 때 collation 을 반드시 명시한다 — erflow·erflow_mig 가 둘 다
    # utf8mb4_general_ci 이고(O-005 실측), 다르게 만들면 한글 정렬이
    # 조용히 어긋난다.
    #
    #   CREATE DATABASE erflow_v2 CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
    #   GRANT ALL PRIVILEGES ON erflow_v2.* TO '<계정>'@'%';
    #
    url: jdbc:mariadb://<호스트>:<포트>/erflow_v2
    username: <계정>
    password: <비밀번호>

erflow:
  legacy:
    # 정합성 검증용 레거시 스키마.
    #
    # 이 계정은 반드시 SELECT 권한만 가져야 한다. 레거시는 정답이고,
    # 정답은 읽기 전용이다 — 관례가 아니라 권한으로 막는다.
    #
    #   GRANT SELECT ON erflow.* TO '<계정>'@'%';
    #
    # 쓰기 권한을 주면 이관 도중 정답이 오염돼도 아무도 모른다.
    url: jdbc:mariadb://<호스트>:<포트>/erflow
